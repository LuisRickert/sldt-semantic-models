@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.1.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.1.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.1.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.1.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:io.catenax.cyber_security_metrics:1.0.0#> .
@prefix ext-number: <urn:samm:io.catenax.shared.business_partner_number:2.0.0#> .

# ============================================================================
# 1. ASPECT DEFINITION (ROOT)
# ============================================================================
# The top-level aspect that defines the entire cyber security metrics model.
# This is the entry point for the semantic model.
# ============================================================================

:CyberSecurityMetrics a samm:Aspect ;
   samm:preferredName "Cyber Security Metrics"@en ;
   samm:description "A cyber security metrics report containing security KPIs for a Catena-X business partner. This aspect model defines the structure for exchanging cyber security performance indicators according to the CyberSecurityMetrics-CSMAPI-Push:1.0.0 specification. The model includes 25 standardized KPIs covering network security, application security, cloud security, data protection, access control, incident response, asset management, vulnerability management, monitoring, and physical security based on TISAX requirements."@en ;
_   samm:properties ( :header :content ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:header a samm:Property ;
   samm:preferredName "Header"@en ;
   samm:description "Message header containing sender, receiver, and metadata information for routing and tracking the cyber security metrics report."@en ;
   samm:characteristic :HeaderCharacteristic .

:content a samm:Property ;
   samm:preferredName "Content"@en ;
   samm:description "Content section containing the actual cyber security metrics data including report identification and KPI values."@en ;
   samm:characteristic :ContentCharacteristic .

# ============================================================================
# 2. HEADER SECTION
# ============================================================================
# Contains all definitions related to the message header:
# - HeaderCharacteristic and HeaderEntity
# - All header properties with their characteristics
# - All header-specific constraints
# ============================================================================

# --- 2.1 Header Structure ---

:HeaderCharacteristic a samm-c:SingleEntity ;
   samm:preferredName "Header Characteristic"@en ;
   samm:description "Describes the characteristics of the message header including all required and optional fields for message routing."@en ;
   samm:dataType :HeaderEntity .

:HeaderEntity a samm:Entity ;
   samm:preferredName "Header Entity"@en ;
   samm:description "Entity representing the complete message header with all routing and metadata information."@en ;
   samm:properties ( 
      :senderBpn 
      :senderFeedbackUrl 
      :context 
      :messageId 
      :receiverBpn 
      :sentDateTime 
      :version 
      [ samm:property :relatedMessageId; samm:optional true ] 
   ) .

# --- 2.2 Header Properties ---

:senderBpn a samm:Property ;
   samm:preferredName "Sender BPN"@en ;
   samm:description "Business Partner Number (BPNL) of the organization sending the cyber security metrics report. Must follow the BPNL format: BPNL followed by 12 alphanumeric characters."@en ;
   samm:characteristic ext-number:BpnlTrait ;
   samm:exampleValue "BPNL0000000001AB" .

:senderFeedbackUrl a samm:Property ;
   samm:preferredName "Sender Feedback URL"@en ;
   samm:description "HTTPS endpoint URL where the sender can receive feedback notifications about the processing status of this message. Must be a valid URI."@en ;
   samm:characteristic :UrlCharacteristic ;
   samm:exampleValue "https://domain.tld/path/to/api" .

:context a samm:Property ;
   samm:preferredName "Context"@en ;
   samm:description "Fixed context identifier that specifies the message type and version. Must always be 'CyberSecurityMetrics-CSMAPI-Push:1.0.0' for this aspect model version."@en ;
   samm:characteristic :ContextCharacteristic ;
   samm:exampleValue "CyberSecurityMetrics-CSMAPI-Push:1.0.0" .

:messageId a samm:Property ;
   samm:preferredName "Message ID"@en ;
   samm:description "Unique message identifier in UUID v4 format. Used for message tracking, deduplication, and correlation. Must be globally unique."@en ;
   samm:characteristic :UuidCharacteristic ;
   samm:exampleValue "3b4edc05-e214-47a1-b0c2-1d831cdd9ba9" .

:receiverBpn a samm:Property ;
   samm:preferredName "Receiver BPN"@en ;
   samm:description "Business Partner Number (BPNL) of the organization receiving the cyber security metrics report. Must follow the BPNL format: BPNL followed by 12 alphanumeric characters."@en ;
   samm:characteristic ext-number:BpnlTrait ;
   samm:exampleValue "BPNL0000000002CD" .

:sentDateTime a samm:Property ;
   samm:preferredName "Sent Date Time"@en ;
   samm:description "Timestamp indicating when the message was sent. Must be in ISO 8601 format with timezone information (UTC or offset). Used for message ordering and time-based processing."@en ;
   samm:characteristic samm-c:Timestamp ;
   samm:exampleValue "2025-05-04T00:00:00-07:00"^^xsd:dateTime .

:version a samm:Property ;
   samm:preferredName "Version"@en ;
   samm:description "Version number of the message header format. Must be '1.0.0' for this version of the specification. Used for version compatibility checks."@en ;
   samm:characteristic :VersionCharacteristic ;
   samm:exampleValue "1.0.0" .

:relatedMessageId a samm:Property ;
   samm:preferredName "Related Message ID"@en ;
   samm:description "Optional UUID v4 of a related or previous message. Used to establish relationships between messages, such as updates, corrections, or responses. If not applicable, this field can be omitted."@en ;
   samm:characteristic :UuidCharacteristic ;
   samm:exampleValue "3b4edc05-e214-47a1-b0c2-1d831cdd9ba9" .

# --- 2.3 Header Characteristics & Constraints ---

:UrlCharacteristic a samm:Characteristic ;
   samm:preferredName "URL Characteristic"@en ;
   samm:description "Characteristic for URL format validation. Ensures the value is a valid URI according to RFC 3986, typically HTTPS endpoints."@en ;
   samm:dataType xsd:anyURI .

:ContextCharacteristic a samm:Characteristic ;
   samm:preferredName "Context Characteristic"@en ;
   samm:description "Fixed context identifier characteristic. The value must always be 'CyberSecurityMetrics-CSMAPI-Push:1.0.0' for this version of the specification."@en ;
   samm:dataType xsd:string .

:UuidCharacteristic a samm-c:Trait ;
   samm:preferredName "UUID Characteristic"@en ;
   samm:description "Characteristic for UUID version 4 format validation. Ensures globally unique identifiers following RFC 4122 standard."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :UuidConstraint .

:UuidConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "UUID Constraint"@en ;
   samm:description "Regular expression constraint ensuring UUID v4 format: 8-4-4-4-12 hexadecimal digits with version indicator '4' in the third group and variant bits '8', '9', 'a', or 'b' in the fourth group."@en ;
   samm:value "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" .

:VersionCharacteristic a samm:Characteristic ;
   samm:preferredName "Version Characteristic"@en ;
   samm:description "Characteristic for semantic version format. Currently fixed to '1.0.0' following semantic versioning (major.minor.patch)."@en ;
   samm:dataType xsd:string .

# ============================================================================
# 3. CONTENT SECTION
# ============================================================================
# Contains all definitions related to the message content:
# - ContentCharacteristic and ContentEntity
# - Report metadata properties (reportId, enclosedSiteBpn, supplierNumber)
# - Content-specific characteristics and constraints
# ============================================================================

# --- 3.1 Content Structure ---

:ContentCharacteristic a samm-c:SingleEntity ;
   samm:preferredName "Content Characteristic"@en ;
   samm:description "Describes the characteristics of the message content including report metadata and cyber security metrics."@en ;
   samm:dataType :ContentEntity .

:ContentEntity a samm:Entity ;
   samm:preferredName "Content Entity"@en ;
   samm:description "Entity representing the complete message content including report identification, optional site/supplier information, and the cyber security metrics data."@en ;
   samm:properties ( 
      :reportId 
      :cyberSecurityMetrics 
      [ samm:property :enclosedSiteBpn; samm:optional true ] 
      [ samm:property :supplierNumber; samm:optional true ] 
   ) .

# --- 3.2 Content Metadata Properties ---

:reportId a samm:Property ;
   samm:preferredName "Report ID"@en ;
   samm:description "Unique report identifier following the format CSM-{YYYY}-{MM}-{SenderBPN}-{SequenceNumber}. Example: CSM-2025-11-BPNL0000000001AB-001. The year and month indicate the reporting period, and the sequence number (001-999) allows for multiple reports per month."@en ;
   samm:characteristic :ReportIdCharacteristic ;
   samm:exampleValue "CSM-2025-11-BPNL0000000001AB-001" .

:enclosedSiteBpn a samm:Property ;
   samm:preferredName "Enclosed Site BPN"@en ;
   samm:description "Optional list of Business Partner Number Addresses (BPNA) representing specific sites or locations covered by this cyber security metrics report. Each BPNA must follow the format: BPNA followed by 12 alphanumeric characters. If the report covers the entire organization, this field can be omitted."@en ;
   samm:characteristic :EnclosedSiteBpnCharacteristic ;
   samm:exampleValue "BPNA00000003AYRE" .

:supplierNumber a samm:Property ;
   samm:preferredName "Supplier Number"@en ;
   samm:description "Optional list of 8-digit supplier identification numbers. Used when the cyber security metrics report needs to reference specific supplier relationships. Each number must be exactly 8 digits. If not applicable, this field can be omitted."@en ;
   samm:characteristic :SupplierNumberCharacteristic ;
   samm:exampleValue "12345678" .

# --- 3.3 Content Metadata Characteristics & Constraints ---

:ReportIdCharacteristic a samm-c:Trait ;
   samm:preferredName "Report ID Characteristic"@en ;
   samm:description "Characteristic for report ID format validation following the pattern CSM-{YYYY}-{MM}-{BPN}-{Seq}."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :ReportIdConstraint .

:ReportIdConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "Report ID Constraint"@en ;
   samm:description "Regular expression ensuring report ID format: 'CSM-' prefix, 4-digit year, 2-digit month (01-12), sender BPNL (BPNL + 12 alphanumeric), and 3-digit sequence number (001-999)."@en ;
   samm:value "^CSM-[0-9]{4}-(0[1-9]|1[0-2])-BPNL[0-9A-Z]{12}-[0-9]{3}$" .

:EnclosedSiteBpnCharacteristic a samm-c:List ;
   samm:preferredName "Enclosed Site BPN List"@en ;
   samm:description "List characteristic for Business Partner Number Address (BPNA) identifiers. Each entry must follow the BPNA format."@en ;
   samm:dataType :BpnaType .

:BpnaType a samm-c:Trait ;
   samm:preferredName "BPNA Type"@en ;
   samm:description "Trait for Business Partner Number Address format validation."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :BpnaConstraint .

:BpnaConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "BPNA Constraint"@en ;
   samm:description "Regular expression ensuring BPNA format: 'BPNA' prefix followed by exactly 12 alphanumeric characters (uppercase letters and digits)."@en ;
   samm:value "^BPNA[0-9A-Z]{12}$" .

:SupplierNumberCharacteristic a samm-c:List ;
   samm:preferredName "Supplier Number List"@en ;
   samm:description "List characteristic for supplier identification numbers. Each entry must be exactly 8 digits."@en ;
   samm:dataType :SupplierNumberType .

:SupplierNumberType a samm-c:Trait ;
   samm:preferredName "Supplier Number Type"@en ;
   samm:description "Trait for 8-digit supplier number format validation."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :SupplierNumberConstraint .

:SupplierNumberConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "Supplier Number Constraint"@en ;
   samm:description "Regular expression ensuring exactly 8 numeric digits for supplier identification."@en ;
   samm:value "^[0-9]{8}$" .

# ============================================================================
# 4. CYBER SECURITY METRICS SECTION
# ============================================================================
# Contains the KPI structure:
# - CyberSecurityMetrics container
# - KPI list structure
# - Individual KPI entity definition
# This section is the core business logic of the aspect model.
# ============================================================================

# --- 4.1 Metrics Container ---

:cyberSecurityMetrics a samm:Property ;
   samm:preferredName "Cyber Security Metrics"@en ;
   samm:description "Container object holding the complete set of cyber security Key Performance Indicators (KPIs). Must contain exactly 25 KPIs, one for each defined metric from CY1.1 to CY1.25. Each KPI provides standardized security measurements across different domains including network security, application security, cloud security, data protection, access control, incident response, asset management, vulnerability management, monitoring, and physical security."@en ;
   samm:characteristic :CyberSecurityMetricsCharacteristic .

:CyberSecurityMetricsCharacteristic a samm-c:SingleEntity ;
   samm:preferredName "Cyber Security Metrics Characteristic"@en ;
   samm:description "Container characteristic for the KPI list ensuring the correct structure and cardinality."@en ;
   samm:dataType :CyberSecurityMetricsEntity .

:CyberSecurityMetricsEntity a samm:Entity ;
   samm:preferredName "Cyber Security Metrics Entity"@en ;
   samm:description "Entity containing the list of cyber security KPIs. Must contain exactly 25 KPI entries, covering all metrics from CY1.1 to CY1.25."@en ;
   samm:properties ( :kpis ) .

# --- 4.2 KPI List ---

:kpis a samm:Property ;
   samm:preferredName "KPIs"@en ;
   samm:description "List of cyber security Key Performance Indicators. Must contain exactly 25 entries, with each KPI ID (CY1.1 through CY1.25) appearing exactly once. The order of KPIs in the list is not prescribed. Each KPI includes identification (ID, readable ID, description), measurement data (value, unit, date), and sharing information (shared flag, not-shared reason)."@en ;
   samm:characteristic :KpisCharacteristic .

:KpisCharacteristic a samm-c:List ;
   samm:preferredName "KPIs List Characteristic"@en ;
   samm:description "List characteristic enforcing exactly 25 KPI entries with unique KPI IDs from CY1.1 to CY1.25."@en ;
   samm:dataType :KpiEntity .

# --- 4.3 KPI Entity Definition ---

:KpiEntity a samm:Entity ;
   samm:preferredName "KPI Entity"@en ;
   samm:description "Entity representing a single cyber security Key Performance Indicator with all its attributes including identification, measurement value, unit, date, and sharing status. Each KPI must conform to the framework version 1.0.0 and include all mandatory fields."@en ;
   samm:properties ( 
      :kpiFrameworkVersion 
      :kpiId 
      :kpiReadableId 
      :kpiDescription 
      :kpiUnit 
      :kpiValue 
      :kpiDate 
      :kpiShared 
      :kpiNotSharedReason 
   ) .

# ============================================================================
# 5. KPI PROPERTIES
# ============================================================================
# All properties that belong to a single KPI entity.
# Organized by logical grouping:
# - Identification (version, id, readableId, description)
# - Measurement (unit, value, date)
# - Sharing (shared, notSharedReason)
# ============================================================================

# --- 5.1 KPI Identification Properties ---

:kpiFrameworkVersion a samm:Property ;
   samm:preferredName "KPI Framework Version"@en ;
   samm:description "Version of the KPI framework defining the metrics. Must be '1.0.0' for this version. Used to ensure compatibility and correct interpretation of KPI definitions. Future versions may introduce new KPIs or modify existing ones."@en ;
   samm:characteristic :KpiFrameworkVersionCharacteristic ;
   samm:exampleValue "1.0.0" .

:kpiId a samm:Property ;
   samm:preferredName "KPI ID"@en ;
   samm:description "Unique identifier for the KPI. Must be one of the predefined values from CY1.1 to CY1.25. Each KPI ID must appear exactly once in the complete KPI list. The ID corresponds to a specific security metric defined in the KPI registry (see section 7)."@en ;
   samm:characteristic :KpiIdCharacteristic ;
   samm:exampleValue "CY1.1" .

:kpiReadableId a samm:Property ;
   samm:preferredName "KPI Readable ID"@en ;
   samm:description "Human-readable identifier for the KPI using lowercase letters, numbers, and underscores (snake_case format). Provides a more descriptive reference than the numeric KPI ID. Example: 'netw_segm_comp' for network segmentation compliance. Useful for logging, debugging, and human-readable reports."@en ;
   samm:characteristic :KpiReadableIdCharacteristic ;
   samm:exampleValue "netw_segm_comp" .

:kpiDescription a samm:Property ;
   samm:preferredName "KPI Description"@en ;
   samm:description "Full text description of what the KPI measures, including the unit notation in square brackets. Provides complete context for understanding and interpreting the KPI value. Should match the official description defined in the KPI registry for consistency."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "Percentage of network segments compliant with defined security postures and access requirements: [%]" .

# --- 5.2 KPI Measurement Properties ---

:kpiUnit a samm:Property ;
   samm:preferredName "KPI Unit"@en ;
   samm:description "Unit of measurement for the KPI value. Must be one of: 'percent' (for percentage values 0-100), 'number' (for count/integer values), or 'days' (for time duration values). The unit determines how the kpiValue should be interpreted and displayed."@en ;
   samm:characteristic :KpiUnitCharacteristic ;
   samm:exampleValue "percent" .

:kpiValue a samm:Property ;
   samm:preferredName "KPI Value"@en ;
   samm:description "Numerical measurement value of the KPI. Must be a non-negative decimal number. For percentage KPIs, values typically range from 0 to 100. For count KPIs, values are typically integers. For days KPIs, values represent time duration. The interpretation depends on the kpiUnit field."@en ;
   samm:characteristic :KpiValueCharacteristic ;
   samm:exampleValue "90"^^xsd:decimal .

:kpiDate a samm:Property ;
   samm:preferredName "KPI Date"@en ;
   samm:description "Date when the KPI was measured or calculated, in YYYY-MM-DD format. Represents the reference date for the reported metric value. Must be a valid calendar date. Used for trend analysis and time-series tracking of security metrics."@en ;
   samm:characteristic :KpiDateCharacteristic ;
   samm:exampleValue "2025-11-15" .

# --- 5.3 KPI Sharing Properties ---

:kpiShared a samm:Property ;
   samm:preferredName "KPI Shared"@en ;
   samm:description "Boolean flag indicating whether the KPI value is shared with the receiver (true) or withheld (false). If false, the kpiNotSharedReason field must contain an explanation (minimum 1 character). If true, kpiNotSharedReason must be an empty string. This mechanism allows organizations to selectively share metrics while maintaining transparency about data sharing decisions."@en ;
   samm:characteristic samm-c:Boolean ;
   samm:exampleValue "true"^^xsd:boolean .

:kpiNotSharedReason a samm:Property ;
   samm:preferredName "KPI Not Shared Reason"@en ;
   samm:description "Explanation for why a KPI value is not shared. REQUIRED and must contain text (minimum 1 character) when kpiShared is false. MUST be empty string when kpiShared is true. This conditional requirement ensures transparency about data sharing decisions. Common reasons include: confidentiality concerns, ongoing security incidents, incomplete data, or contractual restrictions."@en ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "" .

# ============================================================================
# 6. KPI CHARACTERISTICS & CONSTRAINTS
# ============================================================================
# All characteristics and constraints specific to KPI properties.
# Organized by property type for easy maintenance.
# ============================================================================

# --- 6.1 KPI Identification Characteristics ---

:KpiFrameworkVersionCharacteristic a samm:Characteristic ;
   samm:preferredName "KPI Framework Version Characteristic"@en ;
   samm:description "Characteristic for KPI framework version. Fixed to '1.0.0' for this version of the cyber security metrics specification."@en ;
   samm:dataType xsd:string .

:KpiIdCharacteristic a samm-c:Enumeration ;
   samm:preferredName "KPI ID Enumeration"@en ;
   samm:description "Enumeration of all valid KPI identifiers from CY1.1 to CY1.25. Each value must appear exactly once in a complete KPI list."@en ;
   samm:dataType xsd:string ;
   samm-c:values ( "CY1.1" "CY1.2" "CY1.3" "CY1.4" "CY1.5" "CY1.6" "CY1.7" "CY1.8" "CY1.9" "CY1.10" "CY1.11" "CY1.12" "CY1.13" "CY1.14" "CY1.15" "CY1.16" "CY1.17" "CY1.18" "CY1.19" "CY1.20" "CY1.21" "CY1.22" "CY1.23" "CY1.24" "CY1.25" ) .

:KpiReadableIdCharacteristic a samm-c:Trait ;
   samm:preferredName "KPI Readable ID Characteristic"@en ;
   samm:description "Characteristic for human-readable KPI identifiers using snake_case format (lowercase with underscores)."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :KpiReadableIdConstraint .

:KpiReadableIdConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "KPI Readable ID Constraint"@en ;
   samm:description "Regular expression ensuring readable ID format: lowercase letters, digits, and underscores only. Example: 'netw_segm_comp'."@en ;
   samm:value "^[a-z0-9_]+$" .

# --- 6.2 KPI Measurement Characteristics ---

:KpiUnitCharacteristic a samm-c:Enumeration ;
   samm:preferredName "KPI Unit Enumeration"@en ;
   samm:description "Enumeration of valid measurement units for KPIs: 'percent' for percentage values (0-100), 'number' for count/integer values, 'days' for time duration values."@en ;
   samm:dataType xsd:string ;
   samm-c:values ( "percent" "number" "days" ) .

:KpiValueCharacteristic a samm-c:Trait ;
   samm:preferredName "KPI Value Characteristic"@en ;
   samm:description "Characteristic for KPI measurement values. Must be non-negative decimal numbers. Interpretation depends on the associated kpiUnit."@en ;
   samm-c:baseCharacteristic :KpiValueBase ;
   samm-c:constraint :KpiValueConstraint .

:KpiValueBase a samm:Characteristic ;
   samm:preferredName "KPI Value Base"@en ;
   samm:description "Base characteristic for KPI values as decimal numbers."@en ;
   samm:dataType xsd:decimal .

:KpiValueConstraint a samm-c:RangeConstraint ;
   samm:preferredName "KPI Value Constraint"@en ;
   samm:description "Range constraint ensuring KPI values are non-negative (greater than or equal to 0)."@en ;
   samm-c:minValue "0"^^xsd:decimal ;
   samm-c:lowerBoundDefinition samm-c:AT_LEAST .

:KpiDateCharacteristic a samm-c:Trait ;
   samm:preferredName "KPI Date Characteristic"@en ;
   samm:description "Characteristic for KPI measurement dates in YYYY-MM-DD format (ISO 8601 date format without time)."@en ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :KpiDateConstraint .

:KpiDateConstraint a samm-c:RegularExpressionConstraint ;
   samm:preferredName "KPI Date Constraint"@en ;
   samm:description "Regular expression ensuring date format YYYY-MM-DD: 4-digit year, 2-digit month (01-12), 2-digit day (01-31). Note: Does not validate actual calendar validity (e.g., February 30)."@en ;
   samm:value "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" .

# ============================================================================
# 7. KPI REGISTRY
# ============================================================================
# Defines all 25 cyber security KPIs based on TISAX requirements.
# Each KPI includes:
# - Official ID (CY1.x) and readable identifier
# - TISAX domain classification
# - Comprehensive description combining requirement and measurement context
# - Expected unit of measurement
#
# The KPIs are organized by TISAX security domains:
# - Operations Security (11 KPIs)
# - Cryptography (3 KPIs)
# - Identity and Access Management (3 KPIs)
# - IT Security / Cyber Security (3 KPIs)
# - System Acquisitions & Development (1 KPI)
# - Supplier Relationships (1 KPI)
# - Incident Response (1 KPI)
# - Organization of Information Security (1 KPI)
# - Physical Security (1 KPI)
#
# Source: BMW Group EDI Implementation Guideline v1.1 (26.08.2025)
# ============================================================================

# --- 7.1 Operations Security KPIs ---

:KpiCy1_1 a :KpiDefinition ;
   samm:preferredName "Network Segmentation Compliance"@en ;
   samm:description "Implement network segmentation based on risk, function, and access requirements. Define security postures, permitted information types, and security attributes for each zone. This KPI measures the percentage of network segments that comply with defined security postures and access requirements, ensuring proper isolation and controlled communication between network zones."@en ;
   :kpiIdValue "CY1.1" ;
   :kpiReadableIdValue "netw_segm_comp" ;
   :kpiDescriptionValue "Percentage of network segments compliant with defined security postures and access requirements: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_2 a :KpiDefinition ;
   samm:preferredName "Cryptographic Transmission Mechanisms"@en ;
   samm:description "Protect information confidentiality and integrity in transit using cryptographic mechanisms. This KPI measures the percentage of information transmissions that use approved cryptographic mechanisms such as TLS, ensuring data protection during network communication."@en ;
   :kpiIdValue "CY1.2" ;
   :kpiReadableIdValue "cryp_tran_mech" ;
   :kpiDescriptionValue "Percentage of information transmissions using approved cryptographic mechanisms: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Cryptography" .

:KpiCy1_3 a :KpiDefinition ;
   samm:preferredName "IDS/IPS Network Monitoring"@en ;
   samm:description "Implement network-based and/or host-based intrusion detection/prevention systems (IDS/IPS) to monitor and prevent unauthorized exfiltration, exploitation, or modification of information. Monitor and control communications at network boundaries. This KPI measures the percentage of network segments monitored by IDS/IPS and/or the percentage of endpoints with IDS/IPS protection."@en ;
   :kpiIdValue "CY1.3" ;
   :kpiReadableIdValue "netw_segm_ids" ;
   :kpiDescriptionValue "Number of network segments monitored by IDS/IPS : [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_4 a :KpiDefinition ;
   samm:preferredName "Network Zoning Architecture Review Frequency"@en ;
   samm:description "Review and update the network zoning architecture and configuration periodically or when changes occur. This KPI measures how frequently the network zoning architecture is reviewed to ensure it remains aligned with security requirements and business needs."@en ;
   :kpiIdValue "CY1.4" ;
   :kpiReadableIdValue "netw_zone_revi" ;
   :kpiDescriptionValue "Frequency of network zoning architecture reviews: [n times/year]" ;
   :kpiExpectedUnit "number" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_15 a :KpiDefinition ;
   samm:preferredName "System Security Controls Compliance"@en ;
   samm:description "Implement patch management, malware protection, and vulnerability management processes. This KPI measures the percentage of systems compliant with patch management, malware protection, and vulnerability remediation requirements, ensuring comprehensive system security hygiene."@en ;
   :kpiIdValue "CY1.15" ;
   :kpiReadableIdValue "patc_malw_vuln" ;
   :kpiDescriptionValue "Percentage of systems compliant with patch management, malware protection, and vulnerability remediation requirements: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_16 a :KpiDefinition ;
   samm:preferredName "Confidential Data Access Logging"@en ;
   samm:description "Log access to highly confidential data. This KPI measures the percentage of highly confidential data access events that are logged, enabling security monitoring, incident investigation, and compliance with data protection regulations."@en ;
   :kpiIdValue "CY1.16" ;
   :kpiReadableIdValue "data_acce_logg" ;
   :kpiDescriptionValue "Percentage of highly confidential data access events logged: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_19 a :KpiDefinition ;
   samm:preferredName "Critical System Logging and Review"@en ;
   samm:description "Enable logging on critical systems, securely store logs, and review logs for suspicious activities. Keep log data at least 6 months. This KPI measures the percentage of critical systems with logging enabled and logs regularly reviewed for security events."@en ;
   :kpiIdValue "CY1.19" ;
   :kpiReadableIdValue "logg_enab_revi" ;
   :kpiDescriptionValue "Percentage of critical systems with logging enabled and logs regularly reviewed: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_22 a :KpiDefinition ;
   samm:preferredName "Backup and Recovery Capability"@en ;
   samm:description "Support backups without affecting operations, verify backup reliability, automate backups, and recover to a known secure state after disruptions. This KPI measures the percentage of critical systems with reliable, automated backups and tested recovery procedures."@en ;
   :kpiIdValue "CY1.22" ;
   :kpiReadableIdValue "back_auto_reco" ;
   :kpiDescriptionValue "Percentage of critical systems with reliable, automated backups and tested recovery procedures: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_23 a :KpiDefinition ;
   samm:preferredName "System Configuration Compliance"@en ;
   samm:description "Configure systems according to recommended settings, prohibit unnecessary functions and ports, and maintain a component inventory. This KPI measures the percentage of systems compliant with recommended configurations, least functionality principle, and included in component inventory."@en ;
   :kpiIdValue "CY1.23" ;
   :kpiReadableIdValue "conf_leas_inve" ;
   :kpiDescriptionValue "Percentage of systems compliant with recommended configurations, least functionality, and included in component inventory: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

:KpiCy1_14 a :KpiDefinition ;
   samm:preferredName "Business Recovery Testing"@en ;
   samm:description "Establish IT emergency management, business continuity planning, and recovery objectives. Test recovery procedures regularly. This KPI measures the percentage of critical business processes with tested recovery procedures to ensure business continuity capability."@en ;
   :kpiIdValue "CY1.14" ;
   :kpiReadableIdValue "busi_reco_test" ;
   :kpiDescriptionValue "Percentage of critical business processes with tested recovery procedures: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Operations Security" .

# --- 7.2 Cryptography KPIs ---

:KpiCy1_9 a :KpiDefinition ;
   samm:preferredName "Data Encryption at Rest"@en ;
   samm:description "Encrypt data classified as strictly confidential or higher at rest. This KPI measures the percentage of strictly confidential or higher classified data that is encrypted at rest, protecting sensitive information from unauthorized access."@en ;
   :kpiIdValue "CY1.9" ;
   :kpiReadableIdValue "data_encr_rest" ;
   :kpiDescriptionValue "Percentage of strictly confidential or higher data encrypted at rest: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Cryptography" .

:KpiCy1_11 a :KpiDefinition ;
   samm:preferredName "Cryptographic Algorithms and Key Management"@en ;
   samm:description "Use symmetric encryption keys with a minimum length of 256 bits. Implement secure key management practices. This KPI measures the percentage of systems using approved cryptographic algorithms and secure key management practices."@en ;
   :kpiIdValue "CY1.11" ;
   :kpiReadableIdValue "cryp_algo_key" ;
   :kpiDescriptionValue "Percentage of systems using approved cryptographic algorithms and key management practices: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Cryptography" .

# --- 7.3 Identity and Access Management KPIs ---

:KpiCy1_10 a :KpiDefinition ;
   samm:preferredName "Remote Access MFA and VPN"@en ;
   samm:description "Require multi-factor authentication and VPN encryption for remote access from untrusted networks. This KPI measures the percentage of remote access connections from untrusted networks that use both MFA and VPN, ensuring secure remote connectivity."@en ;
   :kpiIdValue "CY1.10" ;
   :kpiReadableIdValue "remo_vpn_mfa" ;
   :kpiDescriptionValue "Percentage of remote access connections from untrusted networks using MFA and VPN: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Identity and Access Management" .

:KpiCy1_18 a :KpiDefinition ;
   samm:preferredName "RBAC Compliance"@en ;
   samm:description "Manage accounts, limit and monitor administrative privileges, implement role-based access control (RBAC), and log unauthorized access attempts. This KPI measures the percentage of user accounts and access rights compliant with RBAC policies."@en ;
   :kpiIdValue "CY1.18" ;
   :kpiReadableIdValue "acce_rbac_comp" ;
   :kpiDescriptionValue "Percentage of user accounts and access rights compliant with RBAC policies: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Identity and Access Management" .

:KpiCy1_20 a :KpiDefinition ;
   samm:preferredName "User Account Management Compliance"@en ;
   samm:description "Implement unique identification, authentication, and authorization for all human users, including multi-factor authentication for untrusted networks. Support account management and role-based permissions mapping. This KPI measures the percentage of user accounts compliant with identification, authentication, authorization, and account management requirements."@en ;
   :kpiIdValue "CY1.20" ;
   :kpiReadableIdValue "user_auth_acco" ;
   :kpiDescriptionValue "Percentage of user accounts compliant with identification, authentication, authorization, and account management requirements: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Identity and Access Management" .

# --- 7.4 IT Security / Cyber Security KPIs ---

:KpiCy1_7 a :KpiDefinition ;
   samm:preferredName "Cloud Tenant Separation"@en ;
   samm:description "Separate BMW data and applications from other tenants. This KPI measures the percentage of cloud environments with proper BMW tenant separation to ensure data isolation and security in multi-tenant cloud environments."@en ;
   :kpiIdValue "CY1.7" ;
   :kpiReadableIdValue "clou_tena_sepa" ;
   :kpiDescriptionValue "Percentage of cloud environments with BMW tenant separation: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "IT Security / Cyber Security" .

:KpiCy1_8 a :KpiDefinition ;
   samm:preferredName "Cloud Security Audit Frequency"@en ;
   samm:description "Monitor cloud assets and events. Conduct regular audits to review security controls. This KPI measures the frequency of cloud security audits performed to ensure ongoing compliance and security of cloud environments."@en ;
   :kpiIdValue "CY1.8" ;
   :kpiReadableIdValue "clou_audi_freq" ;
   :kpiDescriptionValue "Frequency of cloud security audits: [n times/year]" ;
   :kpiExpectedUnit "number" ;
   :tisaxDomain "IT Security / Cyber Security" .

:KpiCy1_21 a :KpiDefinition ;
   samm:preferredName "Endpoint and Session Security"@en ;
   samm:description "Control and monitor wireless connectivity, enforce usage restrictions for portable and mobile devices, implement session locks, and terminate remote sessions after inactivity. This KPI measures the percentage of systems compliant with wireless, portable device, session lock, and remote session termination requirements."@en ;
   :kpiIdValue "CY1.21" ;
   :kpiReadableIdValue "wirl_port_sess" ;
   :kpiDescriptionValue "Percentage of systems compliant with wireless, portable device, session lock, and remote session termination requirements: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "IT Security / Cyber Security" .

# --- 7.5 System Acquisitions, Requirement Management and Development KPIs ---

:KpiCy1_5 a :KpiDefinition ;
   samm:preferredName "Secure Coding and Testing Compliance"@en ;
   samm:description "Adhere to secure coding practices, conduct security testing (DAST/IAST/SAST) and regular Pentests for apps with highest protection level. This KPI measures the percentage of applications compliant with secure coding and testing requirements."@en ;
   :kpiIdValue "CY1.5" ;
   :kpiReadableIdValue "appl_code_test" ;
   :kpiDescriptionValue "Percentage of applications compliant with secure coding and testing : [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "System acquisitions, requirement management and development" .

# --- 7.6 Supplier Relationships KPIs ---

:KpiCy1_6 a :KpiDefinition ;
   samm:preferredName "Supplier Security Compliance"@en ;
   samm:description "Validate vendor secure development practices, security controls, and contractual requirements. Monitor supplier compliance. This KPI measures the percentage of suppliers compliant with security requirements."@en ;
   :kpiIdValue "CY1.6" ;
   :kpiReadableIdValue "supp_secu_comp" ;
   :kpiDescriptionValue "Percentage of suppliers compliant with security requirements: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Supplier Relationships" .

# --- 7.7 Incident Response KPIs ---

:KpiCy1_12 a :KpiDefinition ;
   samm:preferredName "Incident Response Testing and Training"@en ;
   samm:description "Implement an incident response process, team, reporting procedures, classification, communication plan, analysis, post-incident reviews, and 24/7 SOC/MDR with measurable KPIs. This KPI measures the frequency of incident response plan testing and staff training."@en ;
   :kpiIdValue "CY1.12" ;
   :kpiReadableIdValue "inci_resp_trai" ;
   :kpiDescriptionValue "Frequency of incident response plan testing and staff training: [n times/year]" ;
   :kpiExpectedUnit "number" ;
   :tisaxDomain "Incident Response" .

# --- 7.8 Organization of Information Security KPIs ---

:KpiCy1_13 a :KpiDefinition ;
   samm:preferredName "IT Asset Inventory Coverage"@en ;
   samm:description "Perform regular risk assessments, define security roles and responsibilities, maintain an IT asset inventory. This KPI measures the percentage of IT assets included in the inventory."@en ;
   :kpiIdValue "CY1.13" ;
   :kpiReadableIdValue "asse_inve_cove" ;
   :kpiDescriptionValue "Percentage of IT assets included in the inventory: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Organization of Information Security" .

# --- 7.9 Physical Security KPIs ---

:KpiCy1_17 a :KpiDefinition ;
   samm:preferredName "Physical Security Controls Compliance"@en ;
   samm:description "Implement physical security controls for data centers and server rooms. Enforce secure hardware disposal procedures. This KPI measures the percentage of data centers and server rooms compliant with physical security controls."@en ;
   :kpiIdValue "CY1.17" ;
   :kpiReadableIdValue "phys_cent_cont" ;
   :kpiDescriptionValue "Percentage of data centers and server rooms compliant with physical security controls: [%]" ;
   :kpiExpectedUnit "percent" ;
   :tisaxDomain "Physical Security" .

