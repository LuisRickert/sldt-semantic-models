# --- 7.11 KPI Definition Entity and Helper Properties ---

:KpiDefinition a samm:Entity ;
   samm:preferredName "KPI Definition"@en ;
   samm:description "Entity representing the official definition of a cyber security KPI based on TISAX requirements. Includes KPI identification, TISAX domain classification, comprehensive description, and measurement specifications."@en ;
   samm:properties ( 
      :kpiIdValue 
      :kpiReadableIdValue 
      :kpiDescriptionValue 
      :kpiExpectedUnit 
      [ samm:property :tisaxDomain; samm:optional true ]
   ) .

:kpiIdValue a samm:Property ;
   samm:preferredName "KPI ID Value"@en ;
   samm:description "The official KPI identifier value (CY1.x)"@en ;
   samm:characteristic samm-c:Text .

:kpiReadableIdValue a samm:Property ;
   samm:preferredName "KPI Readable ID Value"@en ;
   samm:description "The human-readable identifier value in snake_case format"@en ;
   samm:characteristic samm-c:Text .

:kpiDescriptionValue a samm:Property ;
   samm:preferredName "KPI Description Value"@en ;
   samm:description "The official short description text as it appears in reports"@en ;
   samm:characteristic samm-c:Text .

:kpiExpectedUnit a samm:Property ;
   samm:preferredName "KPI Expected Unit"@en ;
   samm:description "The expected unit of measurement (percent, number, or days)"@en ;
   samm:characteristic samm-c:Text .

:tisaxDomain a samm:Property ;
   samm:preferredName "TISAX Domain"@en ;
   samm:description "The TISAX security domain this KPI belongs to (e.g., Operations Security, Cryptography, Identity and Access Management). Optional field for documentation and categorization purposes."@en ;
   samm:characteristic samm-c:Text .
